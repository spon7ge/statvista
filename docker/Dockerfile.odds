# HTTP odds scrapers (Novig, ProphetX, Underdog, DraftKings, FanDuel, Pinnacle).
# PrizePicks stays on the host.
FROM python:3.12.15-slim

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY --chown=app:app src/ src/
COPY docker/odds-entrypoint.sh /usr/local/bin/odds-entrypoint.sh
RUN chmod 755 /usr/local/bin/odds-entrypoint.sh \
    && mkdir -p /app/data/props \
    && chown -R app:app /app/data

ENV PYTHONPATH=/app \
    ODDS_LEAGUE=all \
    ODDS_EXCLUDE=wnba_prizepick,nba_prizepick,mlb_prizepick \
    ODDS_INTERVAL_SECONDS=300

USER app

ENTRYPOINT ["odds-entrypoint.sh"]
