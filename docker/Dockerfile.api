# Live FastAPI service (WNBA/MLB adapters + odds.* reads)
FROM python:3.12.15-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY --chown=app:app backend/ backend/
COPY --chown=app:app src/ src/
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
# The cache is a runtime volume. Create it so a run without the mount is still
# writable by the unprivileged user.
RUN chmod 755 /usr/local/bin/api-entrypoint.sh \
    && mkdir -p /app/data/cache \
    && chown -R app:app /app/data

ENV PYTHONPATH=/app:/app/backend

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

ENTRYPOINT ["api-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
