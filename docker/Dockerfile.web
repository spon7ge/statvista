# statvista React app, served with nginx; /api is proxied to the api service.
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Unset API origin so the browser uses same-origin /api (nginx proxy).
# --base / so SPA routes like /mlb/matchups resolve assets from the site root.
RUN npx tsc -b && npx vite build --base=/

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
