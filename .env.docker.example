# Local Docker stack defaults.
# Copy to .env before: docker compose up -d

# ── Local Postgres (docker compose --profile local-db) ────────────────────────
POSTGRES_USER=hoopvista
POSTGRES_PASSWORD=hoopvista
POSTGRES_DB=hoopvista
# Host port (5432 is often taken). Containers still talk to postgres:5432 internally.
POSTGRES_PORT=5433
# Inside Docker, use host.docker.internal + published port (works for api + odds)
SUPABASE_DB_URL=postgresql://hoopvista:hoopvista@host.docker.internal:5433/hoopvista?sslmode=disable

# ── External Supabase (use docker-compose.supabase.yml instead of local-db) ──
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Ports ─────────────────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080

# Browser origins allowed to call the API directly (nginx same-origin /api does not need CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ── Odds worker (HTTP scrapers; PrizePicks stays on the host) ─────────────────
ODDS_LEAGUE=all
ODDS_EXCLUDE=wnba_prizepick,mlb_prizepick
ODDS_INTERVAL_SECONDS=300

# ── Live API keys ─────────────────────────────────────────────────────────────
PARLAY_API_KEY=
