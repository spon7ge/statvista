# Git & local artifacts
.git
**/.git
.gitignore
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.venv
**/.venv

# Large / generated data (mount at runtime instead)
data/backtest/
data/raw/
data/props/

# Dependencies and build output (images install or compile their own)
node_modules
**/node_modules
frontend/dist

# dbt build output
dbt/target
dbt/dbt_packages
dbt/logs

# Env and secrets. Pass these at runtime; never copy them into an image.
.env
**/.env
.env.*
**/.env.*
*.pem
*.key
credentials.json

# IDE & OS
.cursor
.vscode
.idea
.DS_Store
*.ipynb_checkpoints

# Model binaries (mount or bake separately)
src/models/saved_models/*.joblib

# Notebooks (not needed in images)
notebooks/
